{
  "cleanUrls": true,
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 9 * * *" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/agendar.html" },
    { "source": "/painel", "destination": "/painel.html" },
    { "source": "/agendar", "destination": "/agendar.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" } ] },
    { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/painel.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/agendar.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/manifest.webmanifest", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/manifest-painel.webmanifest", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
